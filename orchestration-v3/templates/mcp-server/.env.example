# 로컬 개발용. cp .env.example .env
# 로컬은 stdio Inspector + 데모 모드 권장 → OIDC 미설정이어도 동작한다.
# HTTP(global 인증)로 띄우려면 OIDC_* 를 채운다.

APP_ENV=development

# PostgreSQL (schema: llmonl)
POSTGRES_HOST=localhost
POSTGRES_PORT=8066
POSTGRES_DB=mydb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# 사내 IdP (OIDC) — 로컬 데모/stdio면 비워둬도 됨
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

# sample 도메인의 외부 REST — demo_key면 외부 호출 없음
SAMPLE_BASE_URL=https://api.example.com
SAMPLE_API_KEY=demo_key

# MCP 서버
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8000
AUTH_MODE=global

LOG_LEVEL=INFO
