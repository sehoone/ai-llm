# ============================================================
# deploy/.env.example — Docker 배포용 환경변수. cp .env.example .env
# Docker는 env_file 로 값을 컨테이너에 직접 주입한다.
# ============================================================

APP_ENV=production

# ── PostgreSQL (schema: llmonl) ───────────────────────────────
# docker-compose 내부 네트워크에서 서비스명(postgres)을 호스트로 사용
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mydb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# ── 사내 IdP (OIDC) — 토큰 검증만 (ADR-0003) ──────────────────
# HTTP transport + auth_mode=global 이면 필수. 미설정 시 모든 요청 401.
OIDC_ISSUER=https://idp.example.com/
OIDC_AUDIENCE=mcp-server
OIDC_JWKS_URL=https://idp.example.com/.well-known/jwks.json

# ── sample 도메인의 외부 REST ─────────────────────────────────
# demo_key 유지 시 외부 호출 없이 샘플 반환
SAMPLE_BASE_URL=https://api.example.com
SAMPLE_API_KEY=demo_key

# ── MCP 서버 ─────────────────────────────────────────────────
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_WORKERS=1
AUTH_MODE=global

# ── 로깅 ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
