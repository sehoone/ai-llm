{
  // 로컬 소스 분석용 디버그 구성. 사전 조건: DB(pgvector)만 docker로 떠 있어야 함.
  //   cd deploy && docker compose -p orchestration-v3-local --env-file ./environments/local/compose.env up -d db
  // 모니터링(langfuse·grafana·prometheus 등)은 띄우지 않음 → api.env에서 LANGFUSE_ENABLED=false 로 둘 것.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "api: FastAPI debug (no reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["src.main:app", "--host", "0.0.0.0", "--port", "8000"],
      "cwd": "${workspaceFolder}/apps/api",
      "python": "${workspaceFolder}/apps/api/.venv/Scripts/python.exe",
      "env": {
        "ENV_FILE": "${workspaceFolder}/deploy/environments/local/api.env"
      },
      "justMyCode": false,
      "console": "integratedTerminal"
    }
  ]
}
