# deploy/.env — docker compose 변수 (compose가 참조)
# 앱 런타임 env는 backend/.env.${APP_ENV} 에 둔다.

APP_ENV=production

# PostgreSQL
POSTGRES_DB=mydb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Grafana
GRAFANA_PASSWORD=change-me

# Langfuse 스택 (ADR-0007) — self-host 시크릿
CLICKHOUSE_PASSWORD=clickhouse
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniosecret
LANGFUSE_NEXTAUTH_URL=http://localhost:8067
LANGFUSE_NEXTAUTH_SECRET=change-me          # openssl rand -hex 32
LANGFUSE_SALT=change-me                     # openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=change-me-64-hex    # openssl rand -hex 32 (정확히 64 hex 문자)
