# api 런타임 설정 — env 단일 소스 (ADR-0018). 실파일(api.env)은 커밋 금지.
#   • docker 배포: compose가 env_file로 주입. 네트워크 좌표(POSTGRES_HOST/PORT·STORAGE·
#     MINIO_*·LANGFUSE_HOST)는 docker-compose.yml의 environment가 서비스 DNS로 override.
#   • bare-metal 개발(uv run poe dev): 이 파일을 그대로 읽는다(ENV_FILE). 아래 localhost 좌표 사용.
#     localhost DB/관측에 붙으려면 로컬 스택(task deploy ENV=local)이 떠 있어야 한다.
APP_ENV=local

# PostgreSQL — bare-metal은 로컬 스택 노출 포트(localhost:8066). docker는 compose가 db:5432로 override.
# POSTGRES_* 비밀값은 같은 환경의 compose.env와 일치해야 bare-metal 접속이 된다.
POSTGRES_HOST=localhost
POSTGRES_PORT=8066
POSTGRES_DB=mydb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_ME

# 자체 ID/PW 인증 (ADR-0009) — JWT는 32자 이상, 운영에서 반드시 교체.
JWT_SECRET_KEY=REPLACE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 최초 로그인용 seed 관리자 — 비면 생성 건너뜀. 운영 전 교체.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# engine/llm (ADR-0010) — provider·model·key·endpoint는 llm_resource 테이블에서만 온다(env 미참조).
# 활성 chat 리소스가 하나도 없으면 chat은 FakeToolCallingModel(데모)로 폴백. 아래는 생성 튜닝 기본값뿐.
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=0

# 장기 메모리 (ADR-0015) — mem0 + pgvector. opt-in. 추출 LLM=기본 chat 리소스, 임베더=기본 embedding
# 리소스를 llm_resource 테이블에서 해석(env 미참조).
MEMORY_ENABLED=false
MEMORY_COLLECTION=longterm_memory
MEMORY_MAX_COUNT=100

# 첨부 저장 (ADR-0017) — bare-metal은 local 디스크. docker는 compose가 minio로 override.
STORAGE_BACKEND=local
UPLOAD_DIR=uploads

# 회의록 (meeting-minutes) — 음성 업로드·전사·요약. 오디오는 위 스토리지에 "meetings/"로 저장.
# 요약 LLM은 llm_resource 기본 chat 리소스 사용(env 미참조).
MEETING_MAX_AUDIO_MB=200
MEETING_DEFAULT_LOCALE=ko-KR
MEETING_MAX_SPEAKERS=10

# 전사(STT) 외부 서비스 — Azure Fast Transcription(주, 화자 분리) → OpenAI Whisper 폴백.
# 둘 다 비면 전사 없이 오디오만 저장(상태 SAVED).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1

# 사내 IdP (OIDC) — 비활성(코드 보존). OIDC 복귀 시 사용.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

# Langfuse (LLM 관측 — ADR-0007) — bare-metal은 localhost:8067. docker는 langfuse-web:3000로 override.
# 키는 Langfuse UI(http://localhost:8067)에서 발급해 채운다. 비면 자동 비활성.
LANGFUSE_HOST=http://localhost:8067
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENABLED=true
