# api 런타임 설정 — env 단일 소스 (ADR-0018). 실파일(api.env)은 커밋 금지.
#   • docker 배포: compose가 env_file로 주입. 네트워크 좌표(POSTGRES_HOST/PORT·STORAGE·
#     MINIO_*·LANGFUSE_HOST)는 docker-compose.yml의 environment가 서비스 DNS로 override.
#   • bare-metal 개발은 주로 local만 사용. 아래 localhost 좌표는 compose가 override하므로 docker엔 무해.
APP_ENV=dev

# PostgreSQL — docker는 compose가 db:5432로 override. (bare-metal 시 dev 스택 노출 포트 8166)
POSTGRES_HOST=localhost
POSTGRES_PORT=8166
POSTGRES_DB=mydb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_ME

# 자체 ID/PW 인증 (ADR-0009) — JWT는 32자 이상, 운영에서 반드시 교체.
JWT_SECRET_KEY=REPLACE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 최초 로그인용 seed 관리자 — 비면 생성 건너뜀. 운영 전 교체.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# engine/llm (ADR-0010) — 키 비면(그리고 ollama 아니면) chat은 FakeToolCallingModel(데모) 폴백.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_API_BASE=
LLM_API_VERSION=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=0

# 장기 메모리 (ADR-0015) — mem0 + pgvector. opt-in. LLM_API_KEY 재사용.
MEMORY_ENABLED=false
MEMORY_LLM_MODEL=gpt-4o-mini
MEMORY_EMBEDDER_MODEL=text-embedding-3-small
MEMORY_COLLECTION=longterm_memory
MEMORY_MAX_COUNT=100

# 첨부 저장 (ADR-0017) — docker는 compose가 minio로 override.
STORAGE_BACKEND=local
UPLOAD_DIR=uploads

# 사내 IdP (OIDC) — 비활성(코드 보존). OIDC 복귀 시 사용.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

# Langfuse (LLM 관측 — ADR-0007) — docker는 langfuse-web:3000로 override.
# 키는 Langfuse UI(http://localhost:8167)에서 발급해 채운다. 비면 자동 비활성.
LANGFUSE_HOST=http://localhost:8167
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENABLED=true
