{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git stash list)",
      "Bash(git add:*)",
      "Bash(uv run poe lint)",
      "Bash(uv run poe format)",
      "Bash(uv run poe test)",
      "Bash(uv run pytest:*)",
      "Bash(pnpm install)",
      "Bash(pnpm lint)",
      "Bash(pnpm build)",
      "Bash(pnpm dev)",
      "Bash(task lint)",
      "Bash(task test)",
      "Bash(task gen-types)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "mcp__ide__getDiagnostics"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Edit(packages/contracts/**)",
      "Write(packages/contracts/**)",
      "Edit(**/*.tsbuildinfo)",
      "Write(**/*.tsbuildinfo)",
      "Edit(**/api.env)",
      "Write(**/api.env)",
      "Edit(**/compose.env)",
      "Write(**/compose.env)"
    ]
  }
}
