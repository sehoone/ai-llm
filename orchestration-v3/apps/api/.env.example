# APP
APP_ENV=development

# PostgreSQL (schema: llmonl)
POSTGRES_HOST=localhost
POSTGRES_PORT=8066
POSTGRES_DB=mydb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# 자체 ID/PW 인증 — 백엔드가 자격 검증 후 JWT(HS256) 발급.
# JWT_SECRET_KEY는 운영에서 반드시 교체(32자 이상 권장). 스택 내 서비스 간 동일해야 함.
JWT_SECRET_KEY=change-me-to-a-32+char-secret-key!!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 최초 로그인용 seed 관리자 — 기동 시 없으면 생성(SUPERADMIN).
# SEED_ADMIN_PASSWORD가 비면 seed 생성을 건너뛴다. 운영 전 비밀번호 변경 필수.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin1234

# 사내 IdP (OIDC) — 비활성(코드 보존). OIDC 복귀 시 재사용.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

# engine/llm — 실 LLM 호출 (ADR-0010). LiteLLM provider 통합.
# LLM_API_KEY가 비면(그리고 provider가 ollama가 아니면) chat은 FakeToolCallingModel(데모)로 폴백.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_API_BASE=
LLM_API_VERSION=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=0

# 장기 메모리 (ADR-0015) — mem0 + pgvector. opt-in. LLM_API_KEY 재사용.
MEMORY_ENABLED=false
MEMORY_LLM_MODEL=gpt-4o-mini
MEMORY_EMBEDDER_MODEL=text-embedding-3-small
MEMORY_COLLECTION=longterm_memory
MEMORY_MAX_COUNT=100

# Langfuse (LLM 관측 — ADR-0007). 키 비우면 비활성.
# 키는 Langfuse UI(http://localhost:8067)에서 프로젝트 생성 후 발급.
# self-host 컨테이너 내부에서는 LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:8067
LANGFUSE_ENABLED=true
