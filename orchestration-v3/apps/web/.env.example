# 백엔드 (단일 FastAPI, ADR-0003)
NEXT_PUBLIC_API_URL=http://localhost:8000   # 클라이언트 axios base
API_URL=http://localhost:8000               # 서버측 rewrite 목적지 (브라우저로 안 나감)

# 사내 IdP (OIDC) — 인증 위임 (ADR-0003). 로그인/토큰 발급은 IdP 소유, 앱은 리다이렉트만.
NEXT_PUBLIC_OIDC_AUTHORITY=                  # 예: https://idp.company.com/realms/llmonl (discovery 기준 URL)
NEXT_PUBLIC_OIDC_CLIENT_ID=                  # SPA 공개 클라이언트 ID
NEXT_PUBLIC_OIDC_SCOPE=openid profile email
# 미설정 시 `${origin}/auth/callback` 사용
NEXT_PUBLIC_OIDC_REDIRECT_URI=

# 평가(evaluation) 기능용 WebSocket (선택; 미설정 시 NEXT_PUBLIC_API_URL에서 유도)
NEXT_PUBLIC_WS_URL=
